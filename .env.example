# Local values only. Never commit production credentials.
SETUP_TOKEN=replace-with-a-long-random-local-value

# Deployment identifiers are intentionally absent from the showcase source.
CLOUDFLARE_D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
CLOUDFLARE_KV_NAMESPACE_ID=00000000000000000000000000000000

# Set to true only in an explicitly configured production deployment.
PAPERBEE_ENABLE_PRODUCTION_ROUTES=false

